# ---------------------------------------------------------------------------
# KYRO · configuración del backend
# Copia este archivo como .env y ajusta lo que necesites.
# Sin .env el proyecto arranca igual: SQLite, almacenamiento en disco y estado
# efímero en memoria. Todo lo de abajo es lo que se cambia para producción.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Orígenes del frontend permitidos (separados por coma).
CORS_ORIGINS=http://localhost:5173
# URL pública del backend (se usa para construir enlaces de archivos).
PUBLIC_URL=http://localhost:4000

# Base de datos.
#   Desarrollo local (por defecto): SQLite, relativo a backend/prisma
DATABASE_URL=file:./kyro.db
#   Producción: PostgreSQL
# DATABASE_URL=postgresql://kyro:kyro@localhost:5432/kyro?schema=public

# Redis: presencia, salas de voz y eventos entre instancias.
# Sin esta variable se usa un almacén en memoria (válido para una sola instancia).
# REDIS_URL=redis://localhost:6379

# Sesiones. OBLIGATORIO cambiarlos en producción (el servidor no arranca si no).
JWT_SECRET=kyro-development-secret-change-me
JWT_REFRESH_SECRET=kyro-development-refresh-secret-change
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Almacenamiento de archivos: local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# Compatible con S3, R2, MinIO y Spaces.
# S3_BUCKET=kyro
# S3_REGION=auto
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=
# S3_FORCE_PATH_STYLE=true

# WebRTC. El STUN público basta para desarrollo; en producción añade un TURN.
ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]

# Actívalo si el frontend vive en otro dominio (por ejemplo, en Vercel).
# La cookie de sesión pasa a SameSite=None; Secure y exige HTTPS.
CROSS_SITE_COOKIES=false

# Límites y registro.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600
LOG_LEVEL=info
ALLOW_REGISTRATION=true
